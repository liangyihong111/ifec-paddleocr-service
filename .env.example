# Published image or a locally built image such as ifec-paddleocr-service:cpu
OCR_IMAGE=ghcr.io/liangyihong111/ifec-paddleocr-service:cpu-latest
# Docker host binding; keep loopback when exposing OCR through Nginx.
OCR_BIND_HOST=127.0.0.1
OCR_BIND_PORT=8866

# OCR runtime settings
PADDLEOCR_LANG=ch
PADDLEOCR_PIPELINE=ocr
PADDLEOCR_PRELOAD=1
